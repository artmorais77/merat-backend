enum EntityType {
  PF
  PJ
}

model Company {
  id                 String     @id @default(uuid()) @db.Uuid
  entity_type        EntityType
  company_legal_name String?    @unique @db.VarChar(255)
  trade_name         String?    @db.VarChar(255)
  cnpj               String?    @unique @db.VarChar(14)
  full_name          String?    @db.VarChar(255)
  cpf                String?    @unique @db.VarChar(11)
  email              String     @unique @db.VarChar(255)
  phone              String     @db.VarChar(20)
  secondary_phone    String?    @db.VarChar(20)
  country            String?    @db.VarChar(2)
  state              String?    @db.VarChar(2)
  city               String?    @db.VarChar(100)
  street             String?    @db.VarChar(255)
  house_number       String?    @db.VarChar(20)
  zip_code           String?    @db.VarChar(8)
  is_active          Boolean    @default(true)
  created_at         DateTime   @default(now())
  updated_at         DateTime?  @updatedAt

  companies_modules CompanyModules[]
  roles             Role[]
  users             User[]

  @@map("companies")
}

model Module {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(100)
  slug      String  @unique @db.VarChar(100)
  is_active Boolean @default(true)

  company_modules CompanyModules[]
  permissions     Permission[]

  @@map("modules")
}

model CompanyModules {
  company_id String    @db.Uuid
  module_id  String    @db.Uuid
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@id([company_id, module_id])
  @@index([module_id])
  @@map("companies_modules")
}

model Role {
  id         String    @id @default(uuid()) @db.Uuid
  company_id String    @db.Uuid
  name       String    @db.VarChar(100)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  company           Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  roles_permissions RolePermission[]
  users             User[]

  @@unique([company_id, name])
  @@unique([id, company_id])
  @@map("roles")
}

model Permission {
  id         String    @id @default(uuid()) @db.Uuid
  module_id  String    @db.Uuid
  name       String    @db.VarChar(100)
  slug       String    @unique @db.VarChar(100)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  roles_permissions RolePermission[]

  module Module @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([module_id, name])
  @@map("permissions")
}

model RolePermission {
  role_id       String    @db.Uuid
  permission_id String    @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("roles_permissions")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  company_id      String    @db.Uuid
  role_id         String    @db.Uuid
  full_name       String?   @db.VarChar(255)
  cpf             String?   @unique @db.VarChar(11)
  email           String    @unique @db.VarChar(255)
  password_hash   String    @db.VarChar(255)
  phone           String    @db.VarChar(20)
  secondary_phone String?   @db.VarChar(20)
  country         String?   @db.VarChar(2)
  state           String?   @db.VarChar(2)
  city            String?   @db.VarChar(100)
  street          String?   @db.VarChar(255)
  house_number    String?   @db.VarChar(20)
  zip_code        String?   @db.VarChar(8)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [role_id, company_id], references: [id, company_id], onDelete: Restrict)

  @@index([company_id])
  @@index([role_id])
  @@map("users")
}
